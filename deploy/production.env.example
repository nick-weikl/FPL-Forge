# Copy outside the checkout with permissions 0600; inject actual values from a secret store.
# Never commit a filled copy or run `docker compose config` without --quiet (it expands secrets).
DATABASE_URL=postgresql://fpl_web:REPLACE_WITH_SECRET@db.example.invalid:5432/fpl_forge?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
ALLOWED_HOSTS=forge.example.invalid,localhost,127.0.0.1,backend
FPL_SEASON_START=2026
FRONTEND_PORT=8080
# Pin each tested image by registry digest before a hosted release.
BACKEND_IMAGE=fpl-forge-backend:local
FRONTEND_IMAGE=fpl-forge-frontend:local
# For a custom provider CA, add the documented TLS Compose overlay and set:
# DATABASE_CA_FILE=/secure/fpl-forge/provider-ca.crt
# Change DATABASE_URL sslrootcert to /run/secrets/postgres-ca.crt in that case.
