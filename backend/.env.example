# Real secrets belong in the host's secret store, never in Git or frontend variables.
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/fpl_forge
APP_ENV=development
FPL_SEASON_START=2026
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_ADMIN_SYNC=false
# Only for isolated operator access if sync routes are intentionally enabled:
# ADMIN_SYNC_TOKEN=generate_a_random_secret_at_least_32_characters_long
REQUESTS_PER_MINUTE=120
# API_KEY is only needed by optional API-Sports ingestion, never by the browser.
# API_KEY=
